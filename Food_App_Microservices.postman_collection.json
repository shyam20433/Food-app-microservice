      "item": [
        {
          "name": "1.1 Register Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('customer_token', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"Password123!\",\n  \"name\": \"John Customer\",\n  \"phone_number\": \"+919876543210\",\n  \"roles\": [\"CUSTOMER\"]\n}"
            },
            "url": { "raw": "{{user_url}}/auth/register", "host": ["{{user_url}}"], "path": ["auth", "register"] }
          }
        },
