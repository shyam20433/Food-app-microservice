{
  "info": {
    "name": "Restaurant Microservice API Collection",
    "description": "Complete collection to test all Restaurant Microservice endpoints in logical execution order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3334"
    },
    {
      "key": "token",
      "value": "YOUR_JWT_TOKEN"
    },
    {
      "key": "restaurantId",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "itemId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Health Checks",
      "item": [
        {
          "name": "GET Service Health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "GET Liveness Probe",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health/live"
          }
        },
        {
          "name": "GET Database Readiness Probe",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health/ready"
          }
        }
      ]
    },
    {
      "name": "2. Restaurants",
      "item": [
        {
          "name": "POST Create Restaurant + Address",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Super Slice Pizza & Pasta\",\n  \"description\": \"Authentic wood-fired pizza and gourmet pasta.\",\n  \"phone_number\": \"+1555019988\",\n  \"email\": \"contact@superslice.com\",\n  \"opening_time\": \"10:00:00\",\n  \"closing_time\": \"23:00:00\",\n  \"delivery_radius\": 12.5,\n  \"address\": {\n    \"house_no\": \"45A\",\n    \"street\": \"Broadway Avenue\",\n    \"city\": \"Metropolis\",\n    \"state\": \"NY\",\n    \"pincode\": \"10001\",\n    \"latitude\": 40.7128,\n    \"longitude\": -74.0060\n  }\n}"
            },
            "url": "{{baseUrl}}/restaurants"
          }
        },
        {
          "name": "GET List Restaurants (Paginated)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/restaurants?page=1&limit=10&search=Slice"
          }
        },
        {
          "name": "GET Restaurant Details",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}"
          }
        },
        {
          "name": "PUT Update Restaurant",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated: Best artisanal wood-fired pizza in town!\",\n  \"delivery_radius\": 15.0\n}"
            },
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}"
          }
        },
        {
          "name": "PATCH Restaurant Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ENABLED\"\n}"
            },
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}/status"
          }
        }
      ]
    },
    {
      "name": "3. Restaurant Address",
      "item": [
        {
          "name": "GET Restaurant Address",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}/address"
          }
        },
        {
          "name": "PUT Update Restaurant Address",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"house_no\": \"45B\",\n  \"street\": \"Broadway Grand Avenue\",\n  \"city\": \"Metropolis\",\n  \"state\": \"NY\",\n  \"pincode\": \"10002\"\n}"
            },
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}/address"
          }
        }
      ]
    },
    {
      "name": "4. Categories",
      "item": [
        {
          "name": "POST Create Category",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Signature Pizzas\",\n  \"description\": \"Chef special hand-tossed sourdough pizzas\"\n}"
            },
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}/categories"
          }
        },
        {
          "name": "GET List Categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}/categories"
          }
        },
        {
          "name": "GET Category Details",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}/categories/{{categoryId}}"
          }
        },
        {
          "name": "PUT Update Category",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gourmet Specialty Pizzas\"\n}"
            },
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}/categories/{{categoryId}}"
          }
        }
      ]
    },
    {
      "name": "5. Menu Items",
      "item": [
        {
          "name": "POST Create Menu Item",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": \"{{categoryId}}\",\n  \"name\": \"Truffle Mushroom Pizza\",\n  \"description\": \"Wild mushrooms, white truffle oil, fresh mozzarella\",\n  \"price\": 18.99,\n  \"is_vegetarian\": true,\n  \"preparation_time\": 25,\n  \"is_available\": true\n}"
            },
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}/menu-items"
          }
        },
        {
          "name": "GET List Menu Items",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}/menu-items"
          }
        },
        {
          "name": "GET Menu Item Details",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}/menu-items/{{itemId}}"
          }
        },
        {
          "name": "PUT Update Menu Item",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 19.99,\n  \"preparation_time\": 20\n}"
            },
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}/menu-items/{{itemId}}"
          }
        },
        {
          "name": "PATCH Toggle Availability",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_available\": false\n}"
            },
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}/menu-items/{{itemId}}/availability"
          }
        }
      ]
    },
    {
      "name": "6. Soft Deletions",
      "item": [
        {
          "name": "DELETE Menu Item",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}/menu-items/{{itemId}}"
          }
        },
        {
          "name": "DELETE Category",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}/categories/{{categoryId}}"
          }
        },
        {
          "name": "DELETE Address",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}/address"
          }
        },
        {
          "name": "DELETE Restaurant",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/restaurants/{{restaurantId}}"
          }
        }
      ]
    }
  ]
}
